{
  // Cloudflare Workers (Static Assets) configuration for the VIRO Press static frontend.
  // Per ADR 0004 (docs/adr/0004-platform-architecture.md), Cloudflare is the frontend host
  // for the static Vite/Skia SPA. This file is the source of truth for the deploy and is
  // consumed by `npx wrangler deploy` (see docs/deploy/cloudflare-pages.md).
  //
  // WHY Workers Static Assets (not Pages): the Cloudflare deploy pipeline runs
  // `npx wrangler deploy` (the Workers deploy). On a Pages-style config
  // (`pages_build_output_dir`) that command fails with "Missing entry-point to Worker
  // script or to assets directory" because `wrangler deploy` expects either a Worker
  // `main` or an `assets.directory`. VIRO Press ships NO server/Worker code — it is a
  // client-only SPA — so we use an assets-only Worker: the `assets.directory` below is the
  // entry point, and no `main` is needed. This makes the EXISTING `npx wrangler deploy`
  // pipeline succeed with no dashboard/command change.
  //
  // NOTE: "name" is the Cloudflare Worker name. The owner may rename it to match their
  // account/branding — it must be lowercase alphanumeric + dashes only.
  //
  // (No "$schema" key: wrangler is not a repo dependency — it is invoked on demand via
  // `npx wrangler` per docs/deploy/cloudflare-pages.md, so a local schema path would
  // dangle. Add "$schema": "./node_modules/wrangler/config-schema.json" if you later
  // install wrangler as a devDependency.)
  "name": "viro-studio",
  // Bump when adopting newer Workers runtime features (only relevant if/when a Worker
  // script is added for the Supabase/Lenco backend per ADR 0004 — the current SPA ships
  // no Worker code, only static assets).
  "compatibility_date": "2026-08-26",
  "assets": {
    // The Vite build output. `wrangler deploy` uploads this directory as static assets.
    // The `dist/_headers` file (copied from public/ by the build) is parsed by Workers and
    // applied to asset responses — see docs for details.
    "directory": "./dist",
    // SPA history fallback. When an incoming request matches no static file, Workers serves
    // /index.html with a 200 (client-side routes then resolve). Real files (/assets/*,
    // /wasm/*, /ml/*, /fonts/*, /favicon.ico) are matched and served first, so this only
    // affects paths with no matching asset. This replaces the previous Pages-style
    // `_redirects` catch-all `/*  /index.html  200`, which is unsafe under Workers Static
    // Assets (there, `_redirects` rules are always followed regardless of whether an asset
    // matches, so a `/*` proxy would shadow every real asset).
    "not_found_handling": "single-page-application"
  }
}
