{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "VIRO delivery manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "title", "priority", "domain", "state", "outcome", "before", "after", "allowed_paths", "acceptance", "evidence", "builder", "verifier", "critic", "delta"],
  "properties": {
    "id": {"type": "string", "pattern": "^VIRO-[0-9]{4,}$"},
    "title": {"type": "string", "minLength": 8},
    "priority": {"enum": ["P0", "P1", "P2", "P3"]},
    "domain": {"enum": ["editor-core", "canvas-rendering", "typography", "ui-ux", "assets-import", "export", "ai", "platform", "verification", "research-architecture"]},
    "state": {"enum": ["QUEUED", "ACTIVE", "VERIFY", "CRITIC", "REJECTED", "BLOCKED", "DONE"]},
    "outcome": {"type": "string", "minLength": 20},
    "before": {"type": "string", "minLength": 10},
    "after": {"type": "string", "minLength": 10},
    "allowed_paths": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
    "depends_on": {"type": "array", "items": {"type": "string", "pattern": "^VIRO-[0-9]{4,}$"}, "uniqueItems": true, "default": []},
    "acceptance": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 5}},
    "evidence": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 3}},
    "builder": {"$ref": "#/$defs/verdict"},
    "verifier": {"$ref": "#/$defs/verdict"},
    "critic": {"$ref": "#/$defs/verdict"},
    "delta": {
      "type": "object",
      "additionalProperties": false,
      "required": ["before", "after", "proof", "regression_protection", "new_debt"],
      "properties": {
        "before": {"type": "string"},
        "after": {"type": "string"},
        "proof": {"type": "array", "items": {"type": "string"}},
        "regression_protection": {"type": "array", "items": {"type": "string"}},
        "new_debt": {"type": "string"}
      }
    }
  },
  "$defs": {
    "verdict": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "notes"],
      "properties": {
        "status": {"enum": ["PENDING", "PASS", "PARTIAL", "BLOCKED", "REJECTED", "NOT_APPLICABLE"]},
        "notes": {"type": "string"},
        "proof": {"type": "array", "items": {"type": "string"}}
      }
    }
  }
}