# Cloudflare Workers (Static Assets) custom headers for the VIRO Press SPA.
# https://developers.cloudflare.com/workers/static-assets/headers/
# Copied verbatim from public/ into dist/ by the Vite build, then parsed by Workers and
# applied to static-asset responses (overriding the defaults Cloudflare would otherwise
# send). Matching: a single "*" splat greedily matches all characters (including "/").

# ---------------------------------------------------------------------------
# Security headers for every response.
#
# Cross-origin isolation (COOP/COEP) is DELIBERATELY OMITTED.
# VIRO Press does NOT need SharedArrayBuffer / multi-threaded wasm:
#   - ONNX Runtime is forced single-threaded: src/engine/cutout.ts sets
#     ort.env.wasm.numThreads = 1 (executionProviders: ["wasm"]).
#   - CanvasKit loads the standard (non-threaded) canvaskit-wasm/bin/full build
#     (src/engine/canvaskit.ts) — no pthreads, no SharedArrayBuffer.
# Because nothing requires crossOriginIsolated, adding
# Cross-Origin-Embedder-Policy: require-corp would only add risk: it forces a
# CORP/CORS contract on every subresource (wasm, onnx, fonts, images) and is a
# common cause of broken asset loads on Pages. So we do not set it.
#
# The CSP is same-origin by default and additionally allows exactly what the app
# uses:
#   - script-src 'wasm-unsafe-eval'  -> WebAssembly.instantiate for Skia/HarfBuzz/
#     LittleCMS/ONNX (all served same-origin from /wasm, /ml, /assets).
#   - worker-src blob:               -> onnxruntime-web may spin up a wasm worker.
#   - style-src 'unsafe-inline'      -> index.html ships a few static style="..."
#     attributes and desk.css uses data: url() background images.
#   - img-src / connect-src data:    -> the editor decodes and re-fetches data:
#     URLs (thumbnails, PDF export in src/export/pdf.ts).
#   - font-src 'self'                -> bundled Noto faces are fetched same-origin.
/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: accelerometer=(), camera=(), geolocation=(), gyroscope=(), microphone=(), payment=(), usb=()
  Content-Security-Policy: default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'none'; form-action 'self'; script-src 'self' 'wasm-unsafe-eval'; worker-src 'self' blob:; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:; connect-src 'self' data: blob:; manifest-src 'self'

# ---------------------------------------------------------------------------
# Serve WebAssembly with the correct MIME type. Wrangler already maps .wasm to
# application/wasm, but we set it explicitly so streaming compilation
# (WebAssembly.instantiateStreaming) is guaranteed to work for every .wasm under
# /assets/*, /wasm/*, etc. (single splat, greedy).
/*.wasm
  Content-Type: application/wasm

# ---------------------------------------------------------------------------
# Immutable, long-lived caching for content-addressed / stable assets.
#
# /assets/*  -> Vite emits filename-hashed JS/CSS/wasm; safe to cache forever.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# /wasm/*  -> vendored engine runtimes (CanvasKit / HarfBuzz / LittleCMS / ONNX
#             Runtime). Regenerated by scripts/copy-wasm.mjs on postinstall and
#             stable per dependency version.
/wasm/*
  Cache-Control: public, max-age=31536000, immutable

# /ml/*  -> the U2-Netp ONNX model, a stable content-addressed binary.
/ml/*
  Cache-Control: public, max-age=31536000, immutable

# /fonts/*  -> bundled Noto faces, stable per release.
/fonts/*
  Cache-Control: public, max-age=31536000, immutable
